# Backend configuration
MONGO_URI=mongodb://airecruit:airecruit@localhost:27017/?authSource=admin
MONGO_DB=airecruit

JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=43200

# Bootstrap platform owner (created on first startup if no super_admin exists)
SUPERADMIN_EMAIL=owner@airecruit.io
SUPERADMIN_PASSWORD=owner12345
SUPERADMIN_NAME=Platform Owner

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# CV scoring LLM (leave key blank to use the deterministic mock scorer)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# SMTP for exam / meeting emails (optional; logs to console when blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@airecruit.io

# Local file storage root
STORAGE_DIR=storage

STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
